# ======================================
# Revenue Services Platform - Settings
# ======================================

APP_NAME="Multilingual Voice-First Revenue Services Platform"
APP_VERSION="3.0.0"
DEBUG=true
SECRET_KEY="revenue-platform-dev-secret-key-change-in-production"

# Database (SQLite - on-premise)
DATABASE_URL="sqlite:///./revenue_services.db"

# API Settings
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# =============================================
# LLM PROVIDER — Pick ONE: gemini | groq | openrouter
# No Ollama. No phi3. No local LLM. No fallback.
# =============================================
LLM_PROVIDER="gemini"

# Gemini
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-3.6-flash"

# Groq
GROQ_API_KEY=""
GROQ_MODEL="llama3-8b-8192"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"

# ASR/TTS Settings
ASR_PROVIDER="mock"
TTS_PROVIDER="mock"

# Data Guard Settings
DATA_GUARD_ENABLED=true
DATA_GUARD_LOG_ALL=true

# Adapters
AUTH_ADAPTER="mock"
PAYMENT_ADAPTER="mock"
DOCUMENT_ADAPTER="mock"
NOTIFICATION_ADAPTER="mock"

# File Storage
STORAGE_PATH="./data/uploads"
RECEIPT_PATH="./data/receipts"
CERTIFICATE_PATH="./data/certificates"
AUDIO_PATH="./data/audio"

# Session Settings
SESSION_TTL_MINUTES=30

# Fraud Scoring
FRAUD_SCORE_THRESHOLD_REVIEW=0.4
FRAUD_SCORE_THRESHOLD_REJECT=0.7

# Admin Credentials (Officer persona removed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@123"
ADMIN_SECRET_KEY=""

# OCR Configuration
TESSERACT_PATH="C:/Program Files/Tesseract-OCR/tesseract.exe"
OCR_PROVIDER="auto"

