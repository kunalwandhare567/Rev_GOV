# ============================================================
# Multilingual AI-Powered Citizen Revenue Services Platform
# Backend Environment Configuration Template
# ============================================================

APP_NAME="Multilingual AI-Powered Citizen Revenue Services Platform"
APP_VERSION="3.0.0"
DEBUG=true
SECRET_KEY="revenue-services-dev-secret-key-change-in-production"

# Database (SQLite with WAL mode)
DATABASE_URL="sqlite:///./revenue_services.db"

# API Settings
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:5174","http://localhost:8000"]

# ============================================================
# LLM PROVIDER — Pick ONE: openrouter | gemini | groq
# No Ollama. No phi3. No local LLM fallback.
# ============================================================
LLM_PROVIDER="openrouter"

# OpenRouter Configuration (Primary default)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Gemini (Optional configuration option)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Groq (Optional configuration option)
GROQ_API_KEY=""
GROQ_MODEL="llama3-8b-8192"

# ASR/TTS Settings
ASR_PROVIDER="mock"
TTS_PROVIDER="mock"

# Data Guard Settings
DATA_GUARD_ENABLED=true
DATA_GUARD_LOG_ALL=true

# Adapters
AUTH_ADAPTER="mock"
PAYMENT_ADAPTER="mock"
DOCUMENT_ADAPTER="mock"
NOTIFICATION_ADAPTER="mock"

# File Storage Paths
STORAGE_PATH="./data/uploads"
RECEIPT_PATH="./data/receipts"
CERTIFICATE_PATH="./data/certificates"
AUDIO_PATH="./data/audio"

# Session Settings
SESSION_TTL_MINUTES=30

# Fraud Scoring
FRAUD_SCORE_THRESHOLD_REVIEW=0.4
FRAUD_SCORE_THRESHOLD_REJECT=0.7

# Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@123"

# OCR Configuration (Tesseract OCR)
TESSERACT_CMD=""
TESSERACT_PATH="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
OCR_PROVIDER="tesseract"
OCR_LANGUAGE="eng"

# Service Specs
SERVICE_SPECS_DIR="./seed/service_specs"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
