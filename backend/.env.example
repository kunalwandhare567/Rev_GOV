# ======================================
# Revenue Services Platform - Settings
# ======================================

# Application
APP_NAME="Multilingual Voice-First Revenue Services Platform"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY="revenue-platform-dev-secret-key-change-in-production"

# Database (SQLite - on-premise)
DATABASE_URL="sqlite:///./revenue_services.db"

# API Settings
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# LLM Settings (Ollama local)
LLM_PROVIDER="local"          # local | cloud
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="phi3:mini"      # Default: Phi-3 Mini for CPU-only systems
LLM_FALLBACK_ENABLED=true     # Falls back to keyword-based NLU if Ollama unavailable

# ASR/TTS Settings
ASR_PROVIDER="mock"           # mock | whisper (set to whisper if faster-whisper installed)
TTS_PROVIDER="mock"           # mock | piper

# Data Guard Settings
DATA_GUARD_ENABLED=true       # Always enabled; set false only for dev testing
DATA_GUARD_LOG_ALL=true       # Log both ALLOW and BLOCK decisions

# Adapters (mock for POC, real for production)
AUTH_ADAPTER="mock"           # mock | aadhaar_otp
PAYMENT_ADAPTER="mock"        # mock | razorpay | upi
DOCUMENT_ADAPTER="mock"       # mock | layoutlmv3 | doctr
NOTIFICATION_ADAPTER="mock"   # mock | sms | whatsapp_api

# File Storage (local filesystem for POC instead of MinIO)
STORAGE_PATH="./data/uploads"
RECEIPT_PATH="./data/receipts"
CERTIFICATE_PATH="./data/certificates"
AUDIO_PATH="./data/audio"

# Session Settings
SESSION_TTL_MINUTES=30        # Context Vault session expiry

# Fraud Scoring
FRAUD_SCORE_THRESHOLD_REVIEW=0.4
FRAUD_SCORE_THRESHOLD_REJECT=0.7

# Seed Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@123"
OFFICER_USERNAME="officer"
OFFICER_PASSWORD="Officer@123"
